[Unit]
Description=Phibotics Robot Observation Gateway
After=network-online.target
Wants=network-online.target
StartLimitIntervalSec=60
StartLimitBurst=5

[Service]
Type=simple
User=robot-observation-gateway
Group=robot-observation-gateway
ExecStart=/usr/bin/env /opt/robot-agent/bin/robot-observation-gateway-entrypoint --config /etc/robot-observation-gateway/gateway.yaml
Restart=on-failure
RestartSec=2
TimeoutStartSec=30
TimeoutStopSec=10
KillSignal=SIGINT

RuntimeDirectory=robot-observation-gateway
UMask=0077
NoNewPrivileges=yes
PrivateTmp=yes
PrivateDevices=no
ProtectSystem=strict
ProtectHome=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
SystemCallArchitectures=native
ReadOnlyPaths=/etc/robot-observation-gateway
ReadWritePaths=/run/robot-observation-gateway
MemoryHigh=384M
MemoryMax=512M
CPUQuota=150%
CPUWeight=50
OOMScoreAdjust=200
LimitNOFILE=65536
LimitCORE=0

[Install]
WantedBy=multi-user.target
