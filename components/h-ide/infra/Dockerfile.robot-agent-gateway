FROM python:3.12-slim

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1

WORKDIR /app
COPY services/control-api/requirements.txt /tmp/requirements.txt
RUN pip install --no-cache-dir -r /tmp/requirements.txt
COPY packages /app/packages
COPY services /app/services

CMD ["uvicorn", "services.robot_agent_gateway.main:app", "--host", "0.0.0.0", "--port", "8093", "--workers", "1"]
