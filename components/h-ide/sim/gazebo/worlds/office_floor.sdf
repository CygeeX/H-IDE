<?xml version="1.0" ?>
<!--
  Deterministic single-floor office world for Gazebo Harmonic.

  The world intentionally contains only static geometry.  Robot pose,
  camera sensors and Nav2 remain owned by the Robot Agent/Gazebo adapter so
  the H-IDE contract does not acquire a simulator-specific control path.
-->
<sdf version="1.9">
  <world name="office_floor">
    <gravity>0 0 -9.81</gravity>
    <physics name="1ms" type="ode">
      <max_step_size>0.001</max_step_size>
      <real_time_factor>1.0</real_time_factor>
      <real_time_update_rate>1000</real_time_update_rate>
    </physics>

    <plugin filename="gz-sim-physics-system" name="gz::sim::systems::Physics"/>
    <plugin filename="gz-sim-user-commands-system" name="gz::sim::systems::UserCommands"/>
    <plugin filename="gz-sim-scene-broadcaster-system" name="gz::sim::systems::SceneBroadcaster"/>

    <light name="sun" type="directional">
      <cast_shadows>true</cast_shadows>
      <pose>0 0 8 0.35 0.2 -0.4</pose>
      <diffuse>0.85 0.85 0.85 1</diffuse>
      <specular>0.2 0.2 0.2 1</specular>
      <direction>-0.3 0.2 -1</direction>
    </light>

    <model name="floor">
      <static>true</static>
      <link name="link">
        <collision name="collision">
          <geometry><box><size>12 8 0.1</size></box></geometry>
        </collision>
        <visual name="visual">
          <geometry><box><size>12 8 0.1</size></box></geometry>
          <material><ambient>0.25 0.27 0.3 1</ambient><diffuse>0.35 0.37 0.4 1</diffuse></material>
        </visual>
      </link>
    </model>

    <!-- Outer walls: a 12m x 8m navigable floor. -->
    <model name="north_wall"><static>true</static><pose>0 3.95 1.25 0 0 0</pose><link name="link">
      <collision name="collision"><geometry><box><size>12 0.1 2.5</size></box></geometry></collision>
      <visual name="visual"><geometry><box><size>12 0.1 2.5</size></box></geometry></visual>
    </link></model>
    <model name="south_wall"><static>true</static><pose>0 -3.95 1.25 0 0 0</pose><link name="link">
      <collision name="collision"><geometry><box><size>12 0.1 2.5</size></box></geometry></collision>
      <visual name="visual"><geometry><box><size>12 0.1 2.5</size></box></geometry></visual>
    </link></model>
    <model name="west_wall"><static>true</static><pose>-5.95 0 1.25 0 0 0</pose><link name="link">
      <collision name="collision"><geometry><box><size>0.1 8 2.5</size></box></geometry></collision>
      <visual name="visual"><geometry><box><size>0.1 8 2.5</size></box></geometry></visual>
    </link></model>
    <model name="east_wall"><static>true</static><pose>5.95 0 1.25 0 0 0</pose><link name="link">
      <collision name="collision"><geometry><box><size>0.1 8 2.5</size></box></geometry></collision>
      <visual name="visual"><geometry><box><size>0.1 8 2.5</size></box></geometry></visual>
    </link></model>

    <!-- Corridor divider with two real openings (x ~= -1.5 and +1.5). -->
    <model name="corridor_divider_west"><static>true</static><pose>-2.9 1.15 1.25 0 0 0</pose><link name="link">
      <collision name="collision"><geometry><box><size>1.4 0.1 2.5</size></box></geometry></collision>
      <visual name="visual"><geometry><box><size>1.4 0.1 2.5</size></box></geometry></visual>
    </link></model>
    <model name="corridor_divider_middle"><static>true</static><pose>0 1.15 1.25 0 0 0</pose><link name="link">
      <collision name="collision"><geometry><box><size>1.6 0.1 2.5</size></box></geometry></collision>
      <visual name="visual"><geometry><box><size>1.6 0.1 2.5</size></box></geometry></visual>
    </link></model>
    <model name="corridor_divider_east"><static>true</static><pose>2.9 1.15 1.25 0 0 0</pose><link name="link">
      <collision name="collision"><geometry><box><size>1.4 0.1 2.5</size></box></geometry></collision>
      <visual name="visual"><geometry><box><size>1.4 0.1 2.5</size></box></geometry></visual>
    </link></model>

    <!-- Static obstacles used by the first Nav2 avoidance scenario. -->
    <model name="column_obstacle"><static>true</static><pose>2.0 0.8 0.65 0 0 0</pose><link name="link">
      <collision name="collision"><geometry><cylinder><radius>0.38</radius><length>1.3</length></cylinder></geometry></collision>
      <visual name="visual"><geometry><cylinder><radius>0.38</radius><length>1.3</length></cylinder></geometry><material><diffuse>0.45 0.46 0.5 1</diffuse></material></visual>
    </link></model>
    <model name="meeting_table"><static>true</static><pose>3.8 -0.65 0.45 0 0 0</pose><link name="link">
      <collision name="collision"><geometry><box><size>1.6 0.9 0.9</size></box></geometry></collision>
      <visual name="visual"><geometry><box><size>1.6 0.9 0.9</size></box></geometry><material><diffuse>0.28 0.18 0.1 1</diffuse></material></visual>
    </link></model>

    <!-- Semantic visual anchors used by the first VLM/grounding fixture. -->
    <model name="kitchen_counter"><static>true</static><pose>4.45 2.2 0.45 0 0 0</pose><link name="link">
      <collision name="collision"><geometry><box><size>1.4 0.55 0.9</size></box></geometry></collision>
      <visual name="visual"><geometry><box><size>1.4 0.55 0.9</size></box></geometry><material><diffuse>0.18 0.38 0.42 1</diffuse></material></visual>
    </link></model>
    <model name="desk_anchor"><static>true</static><pose>4.9 -2.1 0.45 0 0 0</pose><link name="link">
      <collision name="collision"><geometry><box><size>1.2 0.7 0.9</size></box></geometry></collision>
      <visual name="visual"><geometry><box><size>1.2 0.7 0.9</size></box></geometry><material><diffuse>0.34 0.22 0.12 1</diffuse></material></visual>
    </link></model>
  </world>
</sdf>
