# Workstation control plane
CONTROL_API_TOKEN=replace-with-a-long-random-token
CONTROL_API_HOST=127.0.0.1
CONTROL_API_PORT=8080
CONTROL_DB_PATH=./data/control.db

# Provisioned by docker-compose for the future PostgreSQL/Redis repository
# and event fan-out profile. The current local SQLite profile remains the
# source of truth until those repository adapters are enabled.
DATABASE_URL=postgresql://control:control@localhost:5432/control
REDIS_URL=redis://localhost:6379/0

# Robot/ROS adapter boundaries (never expose these directly to browsers).
ROBOT_AGENT_ENDPOINT=
ROS_DOMAIN_ID=0
WIREGUARD_INTERFACE=
SCENE_STORAGE_ROOT=./data/scenes
VIDEO_ZMQ_ENDPOINT=
