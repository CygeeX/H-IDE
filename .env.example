# Workstation control plane
CONTROL_API_TOKEN=replace-with-a-long-random-token
CONTROL_API_HOST=127.0.0.1
CONTROL_API_PORT=8080
CONTROL_DB_PATH=./data/control.db
# Optional only for a split local Vite profile. These are read by Vite's Node
# process, not exposed through import.meta.env or the browser bundle.
VITE_DEV_PROXY_TARGET=http://127.0.0.1:8080
HIDE_DEV_SCENE_API_TARGET=
HIDE_DEV_SCENE_API_TOKEN=

# H-IDE -> independent Mastra planning service. Both services must share this
# random token (at least 32 characters); do not expose the planning port to
# browser or robot networks. The placeholder intentionally keeps readyz at 503.
MASTRA_PLANNING_URL=http://127.0.0.1:4111
MASTRA_COMPOSE_PLANNING_URL=http://planning-agent:4111
MASTRA_INTERNAL_TOKEN=replace-with-a-different-long-random-token
MASTRA_CONVERSATION_TIMEOUT_SECONDS=30
MASTRA_PLANNING_TIMEOUT_SECONDS=120
# Human review window for an immutable PlanDraft. Confirmation still rechecks
# robot capabilities, safety state, scene binding and pose drift.
ASSISTANT_DRAFT_TTL_SECONDS=900
MASTRA_PORT=4111
SUPERVISOR_MODEL=alibaba-cn/qwen3.8-max
WORKER_MODEL=alibaba-cn/qwen3.8-max
STRUCTURING_MODEL=alibaba-cn/qwen3.8-max
OPENAI_API_KEY=
# Ordinary Alibaba Model Studio API key used by the Mastra text planner and
# qwen3-vl-plus visual service. Keep it server-side only.
DASHSCOPE_API_KEY=
# Low-latency Assistant V2 speech. DashScope is the default for both paths;
# FunASR is used only when SPEECH_ASR_PROVIDER=funasr is set explicitly.
SPEECH_ASR_PROVIDER=dashscope
SPEECH_TTS_PROVIDER=dashscope
DASHSCOPE_REGION=cn-beijing
# Ordinary Beijing/Singapore API keys use the region's public realtime domain.
# Set a workspace ID only for workspace-scoped Model Studio deployments.
DASHSCOPE_WORKSPACE_ID=
# A complete ASR endpoint overrides both workspace and regional defaults. Keep
# credentials out of URLs; they belong only in DASHSCOPE_API_KEY above.
DASHSCOPE_ASR_WS_URL=
DASHSCOPE_ASR_MODEL=qwen3-asr-flash-realtime
# The TTS URL normally derives from DASHSCOPE_REGION; override only for an
# operator-approved endpoint.
DASHSCOPE_TTS_WS_URL=
DASHSCOPE_TTS_MODEL=qwen3-tts-flash-realtime
DASHSCOPE_TTS_VOICE=Cherry
FUNASR_WS_URL=ws://127.0.0.1:10095
# Native DeepSeek provider; for example deepseek/deepseek-v4-flash.
DEEPSEEK_API_KEY=
# If a model identifier uses another provider, set its corresponding key.
ANTHROPIC_API_KEY=
GOOGLE_GENERATIVE_AI_API_KEY=
GROQ_API_KEY=
MISTRAL_API_KEY=
A2A_ALLOWED_ORIGINS=
A2A_WORKERS_JSON=[]

# Optional local whisper.cpp. The browser produces 16 kHz mono PCM WAV and the
# control API sends it to this internal endpoint.
WHISPER_ENDPOINT=http://127.0.0.1:8081/inference
WHISPER_COMPOSE_ENDPOINT=http://whisper:8080/inference
WHISPER_TIMEOUT_SECONDS=45
WHISPER_CPP_VERSION=v1.9.2
WHISPER_PORT=8081
WHISPER_MODEL_DIR=../models
WHISPER_MODEL_NAME=ggml-small.bin

# Provisioned by docker-compose for the future PostgreSQL/Redis repository
# and event fan-out profile. The current local SQLite profile remains the
# source of truth until those repository adapters are enabled.
DATABASE_URL=postgresql://control:control@localhost:5432/control
REDIS_URL=redis://localhost:6379/0

# Robot/ROS adapter boundaries (never expose these directly to browsers).
ROBOT_AGENT_ENDPOINT=
# Optional loopback-only Robot Agent diagnostics endpoint. This is read by the
# authenticated H-IDE BFF; browsers never connect to it directly.
ROBOT_AGENT_DIAGNOSTICS_URL=
# false keeps the self-contained FakeAdapter demo. Set true explicitly only
# when Control API must use the internal Robot Agent Gateway.
ROBOT_AGENT_GATEWAY_ENABLED=false
ROBOT_AGENT_GATEWAY_URL=http://127.0.0.1:8093
# The current local Robot Agent client profile connects to 127.0.0.1:8093.
ROBOT_AGENT_GATEWAY_PORT=8093
ROBOT_AGENT_GATEWAY_TOKEN=replace-with-a-fourth-long-random-token
# websocket_inbound keeps the Robot Agent in client mode and accepts it at /agent.
# For local loopback integration set ID/digest to the values printed by Robot Agent validate-config.
# Run the Gateway on the host when Robot Agent connects to ws://127.0.0.1:8093/agent.
ROBOT_AGENT_GATEWAY_BACKEND=unavailable
ROBOT_AGENT_WS_URL=
# Re-run Robot Agent validate-config after every command/config change and copy
# its exact digest here. A mismatch is intentionally rejected at handshake.
ROBOT_AGENT_ID=g1-dev
ROBOT_AGENT_CAPABILITIES_DIGEST=
ROBOT_AGENT_CAPABILITIES=navigation.navigate_to_pose,navigation.rotate,power.enable,task.execute
# Required when ROBOT_AGENT_GATEWAY_ENABLED=true; must exactly match the live
# Observation Gateway/localization publisher. H-IDE never guesses this
# identity from the control WebSocket.
ROBOT_AGENT_LOCALIZATION_EPOCH_ID=
MISSION_V2_CURRENT_POSE_MAX_AGE_SECONDS=2
ROBOT_AGENT_ALLOW_PLAINTEXT_LOOPBACK=false
# Before a navigation command leaves the workstation, require a recent
# Robot Agent observation snapshot for the exact reviewed session/epoch.
ROBOT_AGENT_OBSERVATION_PREFLIGHT_TIMEOUT_SECONDS=2
ROBOT_AGENT_OBSERVATION_PREFLIGHT_MAX_AGE_MS=400
ROBOT_AGENT_TLS_CA=
ROBOT_AGENT_TLS_CERT=
ROBOT_AGENT_TLS_KEY=
VISUAL_MISSION_MODE=observe
VISUAL_MISSION_COMMAND_POLL_SECONDS=0.25
HIDE_VISION_URL=http://127.0.0.1:8092
# H-IDE Vision runs once in its locked host GPU environment. Docker services
# reach that same HTTP process through the host bridge.
HIDE_VISION_COMPOSE_URL=http://host.docker.internal:8092
HIDE_VISION_AGENT_TOKEN=replace-with-the-vision-agent-token
HIDE_VISION_CONTROL_TOKEN=replace-with-the-vision-control-token
HIDE_VISION_SOURCE_MODE=synthetic
HIDE_VISION_SENSOR_IDS=head_rgbd
HIDE_VISION_VLM_PROVIDER=qwen
HIDE_VISION_VLM_MODEL=qwen3-vl-plus
HIDE_MISSION_TEXT_PROVIDER=deepseek
HIDE_MISSION_TEXT_MODEL=deepseek-v4-flash
HIDE_MISSION_VISION_PROVIDER=qwen
HIDE_MISSION_VISION_MODEL=qwen3-vl-plus
HIDE_VISION_QWEN_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
# Required by the separately started host GPU service (not passed to Docker):
# HIDE_VISION_SAM2_CHECKPOINT=/absolute/path/to/sam2.1_hiera_tiny.pt
HIDE_VISION_SAM2_DEVICE=cuda
# Wait briefly for the three-frame stable set; freshness gates remain unchanged.
HIDE_VISION_STABLE_FRAME_WAIT_SECONDS=1
HIDE_VISION_PROMPT_VERSION=visual-grounding-v1
HIDE_VISION_ALGORITHM_VERSION=rgbd-median-v1

# Developer diagnostics aggregation (read-only GET probes only).
SIMULATION_ROBOT_AGENT_DIAGNOSTICS_URL=http://127.0.0.1:8796
SIMULATION_ROBOT_AGENT_GATEWAY_URL=http://127.0.0.1:8094
DEVELOPER_DIAGNOSTICS_TIMEOUT_SECONDS=0.8
HIDE_RELEASE_VERSION=0.1.0
HIDE_AGENT_RELEASE_VERSION=unknown
HIDE_VISION_RELEASE_VERSION=0.1.0
HIDE_SIMULATION_RELEASE_VERSION=unknown
HIDE_VISION_APPROACH_POLICY_VERSION=v1
HIDE_VISION_APPROACH_POLICY_SHA256=a97bcf51b108b7c5c5241a82e2710eadb2619f12a1aba6e328d77b5474f35fc0
ROS_DOMAIN_ID=0
# H-IDE-owned simulation profile. The initial backend is deterministic; the
# Gazebo profile reuses the same API and is started as a host ROS 2 process.
SIMULATION_DB_PATH=./data/control.db
SIMULATION_BACKEND=deterministic
SIMULATION_EXECUTION_PROFILE=simulation
SIMULATION_SOURCE_MODE=synthetic
# Simulation and live-camera observations share the Qwen + SAM 2 host service.
# MuJoCo renderer labels are evaluator-only data and are not configurable here.
WIREGUARD_INTERFACE=
SCENE_STORAGE_ROOT=./data/scenes
SCENE_API_PORT=8090
SCENE_API_INTERNAL_TOKEN=replace-with-a-third-long-random-token
SCENE_API_INTERNAL_URL=http://127.0.0.1:8090
SCENE_API_HOST_INTERNAL_URL=http://127.0.0.1:8090
SCENE_API_TIMEOUT_SECONDS=3
SPATIAL_CONFIRM_TRANSLATION_DRIFT_METERS=0.5
SPATIAL_CONFIRM_YAW_DRIFT_RADIANS=0.35
SCENE_MAX_UPLOAD_BYTES=2147483648
SCENE_UPLOAD_CHUNK_SIZE=8388608
SCENE_DISK_RESERVE_BYTES=1073741824
SCENE_ASSET_COOKIE_SECURE=false
SCENE_TARGET_CLEARANCE_METERS=0.35
SCENE_JOB_LEASE_SECONDS=300
SCENE_JOB_POLL_SECONDS=2
SCENE_COMMAND_TIMEOUT_SECONDS=3600
SCENE_WORKER_CPUS=2.0
SCENE_WORKER_MEMORY=4g
VIDEO_ZMQ_ENDPOINT=
