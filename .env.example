# Internal H-IDE -> Mastra boundary. Use the same random value of at least 32
# characters in both processes; this endpoint must not be exposed to the
# browser. The placeholder intentionally keeps readyz at 503.
MASTRA_INTERNAL_TOKEN=replace-with-a-long-random-token
HOST=127.0.0.1
PORT=4111

# Mastra model identifiers. WORKER_MODEL falls back to SUPERVISOR_MODEL.
SUPERVISOR_MODEL=alibaba-cn/qwen3.8-max
WORKER_MODEL=alibaba-cn/qwen3.8-max
STRUCTURING_MODEL=alibaba-cn/qwen3.8-max
# Assistant V2 conversation routing reuses SUPERVISOR_MODEL. Its bounded
# classifier disables Alibaba/DeepSeek thinking and uses temperature 0; no
# separate conversation key or model is required.
OPENAI_API_KEY=
# DeepSeek models use identifiers such as deepseek/deepseek-v4-flash.
DEEPSEEK_API_KEY=
# Alibaba Cloud China models use identifiers such as
# alibaba-cn/qwen3.8-max and the ordinary Model Studio API key.
DASHSCOPE_API_KEY=
# Other supported provider checks: ANTHROPIC_API_KEY,
# GOOGLE_GENERATIVE_AI_API_KEY, GROQ_API_KEY, MISTRAL_API_KEY.

# Durable local planning jobs and Mastra conversation memory.
PLANNING_DATABASE_URL=file:./data/planning.db
MASTRA_MEMORY_URL=file:./data/memory.db

# H-IDE Vision is called only by vision-worker. These values pin the reviewed
# observation source and deterministic model/policy versions into each draft.
HIDE_VISION_URL=http://127.0.0.1:8092
HIDE_VISION_AGENT_TOKEN=replace-with-the-vision-agent-token
HIDE_VISION_SOURCE_MODE=synthetic
HIDE_VISION_SENSOR_IDS=head_rgbd
HIDE_VISION_VLM_PROVIDER=QwenVlmProvider
HIDE_VISION_VLM_MODEL=qwen3-vl-plus
HIDE_VISION_PROMPT_VERSION=visual-grounding-v1
HIDE_VISION_ALGORITHM_VERSION=rgbd-median-v1
HIDE_VISION_APPROACH_POLICY_VERSION=v1
HIDE_VISION_APPROACH_POLICY_SHA256=a97bcf51b108b7c5c5241a82e2710eadb2619f12a1aba6e328d77b5474f35fc0

# Optional external specialist agents. Every URL origin must be explicitly
# listed. Outside localhost, only HTTPS URLs are accepted.
A2A_ALLOWED_ORIGINS=
A2A_WORKERS_JSON=[]
