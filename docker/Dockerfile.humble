ARG ROS_HUMBLE_BASE=ros:humble-ros-base-jammy@sha256:09da889006b4d4f120ada9b788394d566818f9e451f59a3a9246a1f9eecf849b
FROM ${ROS_HUMBLE_BASE}

SHELL ["/bin/bash", "-c"]

RUN apt-get update && apt-get install -y --no-install-recommends \
      python3-colcon-common-extensions \
      python3-numpy \
      python3-opencv \
      python3-pip \
      python3-pytest \
      ros-humble-example-interfaces \
      ros-humble-geometry-msgs \
      ros-humble-nav-msgs \
      ros-humble-nav2-msgs \
      ros-humble-sensor-msgs \
      ros-humble-std-srvs \
      ros-humble-tf2-ros \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /workspace
COPY . /workspace

RUN python3 -m pip install --no-cache-dir --no-deps \
      --upgrade --force-reinstall \
      --constraint /workspace/docker/constraints-humble.txt \
      google-crc32c==1.8.0 \
      grpcio==1.83.0 \
      protobuf==6.33.6 \
      zstandard==0.25.0 \
    && python3 -m pip install --no-cache-dir \
      --constraint /workspace/docker/constraints-humble.txt \
      -e /workspace/src/robot_agent \
      -e /workspace/src/robot_observation_gateway \
      pytest==8.4.2 \
      pytest-asyncio==1.4.0 \
      pytest-cov==7.1.0

RUN source /opt/ros/humble/setup.bash \
    && colcon build --packages-select robot_observation_interfaces

CMD ["bash", "-lc", "source /opt/ros/humble/setup.bash && source /workspace/install/setup.bash && python3 -m pytest -q"]
