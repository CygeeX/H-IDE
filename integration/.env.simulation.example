# Copy this file to the repository root as .env and keep it mode 0600.
# bootstrap.sh fills the internal development tokens when they are left blank.

CONTROL_API_TOKEN=
SCENE_API_INTERNAL_TOKEN=
CONTROL_API_HOST=127.0.0.1
CONTROL_API_PORT=8080
CONTROL_DB_PATH=/data/control.db

# The frozen integration uses DeepSeek for text routing/planning.
MASTRA_COMPOSE_PLANNING_URL=http://planning-agent:4111
MASTRA_PLANNING_URL=http://127.0.0.1:4111
MASTRA_INTERNAL_TOKEN=
MISSION_V2_INTERNAL_TOKEN=
MASTRA_PLANNING_TIMEOUT_SECONDS=120
MASTRA_CONVERSATION_TIMEOUT_SECONDS=30
ASSISTANT_DRAFT_TTL_SECONDS=900
SUPERVISOR_MODEL=deepseek/deepseek-v4-flash
WORKER_MODEL=deepseek/deepseek-v4-flash
STRUCTURING_MODEL=deepseek/deepseek-v4-flash
DEEPSEEK_API_KEY=

# Qwen/SAM2 visual service (the API key is never committed).
DASHSCOPE_API_KEY=
HIDE_VISION_VLM_PROVIDER=qwen
HIDE_VISION_VLM_MODEL=qwen3-vl-plus
HIDE_VISION_SAM2_CHECKPOINT=
HIDE_VISION_SAM2_DEVICE=cuda
HIDE_VISION_SOURCE_MODE=synthetic
HIDE_VISION_SENSOR_IDS=head_rgbd
HIDE_VISION_AGENT_TOKEN=
HIDE_VISION_CONTROL_TOKEN=

# Simulation and ROS boundaries.
ROBOT_AGENT_GATEWAY_ENABLED=true
SIMULATION_ROBOT_AGENT_ID=g1-sim
SIMULATION_ROBOT_AGENT_GATEWAY_URL=http://host.docker.internal:8094
SIMULATION_ROBOT_AGENT_GATEWAY_TOKEN=
SIMULATION_ROBOT_AGENT_DIAGNOSTICS_URL=http://host.docker.internal:8797
ROBOT_AGENT_GATEWAY_TOKEN=
HIDE_SIM_RETAIN_SONIC_ON_AUTOMATIC_FAULT=1
HIDE_DOCKER_OBSERVATION_BIND_HOST=auto

# Artifact/cache roots. These paths are operator-local and ignored by Git.
SKILLSTORE_EXTERNAL_ROOT=
SONIC_HF_CACHE=
HIDE_G1_MODEL_ROOT=
SKILLSTORE_ACCEPT_G1_MODEL_TERMS=0

# Optional speech services.
SPEECH_ASR_PROVIDER=dashscope
SPEECH_TTS_PROVIDER=dashscope
DASHSCOPE_REGION=cn-beijing
DASHSCOPE_ASR_MODEL=qwen3-asr-flash-realtime
DASHSCOPE_TTS_MODEL=qwen3-tts-flash-realtime
DASHSCOPE_TTS_VOICE=Cherry

# Compose-only infrastructure values; use private/local values for development.
DATABASE_URL=postgresql://control:control@postgres:5432/control
REDIS_URL=redis://redis:6379/0
MASTRA_PORT=4111
A2A_ALLOWED_ORIGINS=
A2A_WORKERS_JSON=[]
