+import math
 import sys
 import threading
 from typing import Dict, Tuple
@@ -19,6 +20,42 @@ from unitree_sdk2py.idl.unitree_go.msg.dds_ import WirelessController_
 from unitree_sdk2py.idl.unitree_hg.msg.dds_ import HandCmd_, HandState_
 
 
+# LowCmd.reserve is explicitly available for application-defined transport
+# metadata.  H-IDE uses it only to correlate a simulator LowState tick with the
+# resulting controller command; the actuator values and official CRC remain
+# unchanged.  The async-boundary marker is reserved for a stop/fault write
+# originating outside the 50 Hz owner thread.
+HIDE_CONTROL_TICK_MAGIC = 0x48494445
+HIDE_ASYNC_BOUNDARY_MAGIC = 0x48494446
+
+
+def simulation_time_to_tick_ms(value: object) -> int:
+    """Encode MuJoCo time without truncation drift at control boundaries.
+
+    MuJoCo advances ``data.time`` by repeated floating-point additions.  Using
+    ``int(time * 1000)`` floors values such as ``155.69599999999994`` to
+    155695 ms.  At 4 ms physics / 20 ms control cadence that occasionally turns
+    one authoritative controller interval into 23 or 24 ms.  Rounding to the
+    nearest integer millisecond preserves the configured integral-millisecond
+    physics clock; it does not derive time from wall scheduling.
+    """
+
+    if isinstance(value, bool):
+        raise ValueError("MuJoCo simulation time must be finite and non-negative")
+    try:
+        seconds = float(value)
+    except (TypeError, ValueError, OverflowError) as exc:
+        raise ValueError(
+            "MuJoCo simulation time must be finite and non-negative"
+        ) from exc
+    if not math.isfinite(seconds) or seconds < 0.0:
+        raise ValueError("MuJoCo simulation time must be finite and non-negative")
+    tick_ms = int(round(seconds * 1_000.0))
+    if tick_ms > 0xFFFFFFFF:
+        raise ValueError("MuJoCo simulation time exceeds LowState.tick range")
+    return tick_ms
+
+
