@@ -132,10 +174,101 @@ class UnitreeSdk2Bridge:
             self.new_right_hand_cmd = False
 
     def LowCmdHandler(self, msg):
-        with self.low_cmd_lock:
+        with self.low_cmd_condition:
             self.low_cmd = msg
             self.low_cmd_received = True
             self.new_low_cmd = True
+            self.low_cmd_sequence += 1
+            reserve = getattr(msg, "reserve", ())
+            marker = int(reserve[0]) if len(reserve) >= 1 else 0
+            self.low_cmd_control_tick_ms = (
+                int(reserve[1])
+                if marker == HIDE_CONTROL_TICK_MAGIC and len(reserve) >= 2
+                else None
+            )
+            self.low_cmd_async_boundary = marker == HIDE_ASYNC_BOUNDARY_MAGIC
+            self.low_cmd_condition.notify_all()
+
+    def LowCmdSequence(self) -> int:
+        """Return the process-local count of DDS actuator commands received."""
+
+        with self.low_cmd_lock:
+            return int(self.low_cmd_sequence)
+
+    def LowCmdIdentity(self):
+        """Atomically snapshot the latest simulator correlation metadata.
+
+        The Plant uses the stamped control tick to learn SONIC's 50 Hz phase.
+        That phase is relative to the first LowState consumed by SONIC and is
+        not necessarily aligned to a global ``tick % 20 == 0`` boundary.
+        """
+
+        with self.low_cmd_lock:
+            return (
+                int(self.low_cmd_sequence),
+                (
+                    None
+                    if self.low_cmd_control_tick_ms is None
+                    else int(self.low_cmd_control_tick_ms)
+                ),
+                bool(self.low_cmd_async_boundary),
+            )
+
+    def WaitForLowCmdAfter(self, sequence: int, timeout_s: float) -> bool:
+        """Wait for a LowCmd newer than ``sequence`` without consuming it.
+
+        The H-IDE Plant uses this only after publishing a 50 Hz LowState and
+        only after the fall-arrest has been released.  Pausing simulation time
+        here preserves the official synchronous observation/action cadence
+        during host scheduling jitter; it never fabricates or replays a
+        controller output.
+        """
+
+        if isinstance(sequence, bool) or not isinstance(sequence, int) or sequence < 0:
+            raise ValueError("LowCmd sequence must be a non-negative integer")
+        if isinstance(timeout_s, bool):
+            raise ValueError("LowCmd wait timeout must be finite and non-negative")
+        timeout = float(timeout_s)
+        if not math.isfinite(timeout) or timeout < 0.0:
+            raise ValueError("LowCmd wait timeout must be finite and non-negative")
+        with self.low_cmd_condition:
+            return bool(
+                self.low_cmd_condition.wait_for(
+                    lambda: self.low_cmd_sequence > sequence,
+                    timeout=timeout,
+                )
+            )
+
+    def WaitForLowCmdForTick(
+        self,
+        sequence: int,
+        tick_ms: int,
+        timeout_s: float,
+    ) -> bool:
+        """Wait for a fresh command correlated to ``tick_ms`` or an async stop."""
+
+        if isinstance(tick_ms, bool) or not isinstance(tick_ms, int) or tick_ms < 0:
+            raise ValueError("LowCmd correlation tick must be non-negative")
+        if isinstance(sequence, bool) or not isinstance(sequence, int) or sequence < 0:
+            raise ValueError("LowCmd sequence must be a non-negative integer")
+        if isinstance(timeout_s, bool):
+            raise ValueError("LowCmd wait timeout must be finite and non-negative")
+        timeout = float(timeout_s)
+        if not math.isfinite(timeout) or timeout < 0.0:
+            raise ValueError("LowCmd wait timeout must be finite and non-negative")
+        with self.low_cmd_condition:
+            return bool(
+                self.low_cmd_condition.wait_for(
+                    lambda: (
+                        self.low_cmd_sequence > sequence
+                        and (
+                            self.low_cmd_control_tick_ms == tick_ms
+                            or self.low_cmd_async_boundary
+                        )
+                    ),
