+RESET_POLICY_AUTOMATIC = "automatic"
+RESET_POLICY_EXPLICIT_PROCESS_RESTART = "explicit_process_restart"
+RESET_POLICIES = frozenset(
+    {RESET_POLICY_AUTOMATIC, RESET_POLICY_EXPLICIT_PROCESS_RESTART}
+)
+
+
+class SimulationRestartRequired(RuntimeError):
+    """The plant cannot recover without an operator-visible process restart."""
+
+
+def reset_policy(config: Dict[str, any]) -> str:
+    """Return and validate the simulator reset policy.
+
+    Upstream callers retain their historical automatic-reset behaviour when
+    the field is absent. H-IDE's acceptance profile opts into the strict mode
+    so a fall, numerical fault, or manual reset cannot masquerade as a
+    successful continuous mission by teleporting the robot to its spawn pose.
+    """
+
+    value = str(config.get("RESET_POLICY", RESET_POLICY_AUTOMATIC))
+    if value not in RESET_POLICIES:
+        raise ValueError(
+            "RESET_POLICY must be one of " + ", ".join(sorted(RESET_POLICIES))
+        )
+    return value
+
 
