{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://h-ide.local/schemas/skillstore-l3-mission-result-v1.json",
  "title": "Skillstore L3 Mission Acceptance Result",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "releaseId",
    "repositoryCommit",
    "recordedAt",
    "missionId",
    "operatorAuthorized",
    "missionStatus",
    "navigationSucceeded",
    "inspectionSucceeded",
    "officeSequenceValidated",
    "allRequiredNodesSucceeded",
    "allRequiredHeadingsObserved",
    "reportFullChainAccepted",
    "regionIds",
    "stationIds",
    "headingGapCount",
    "reportEvidenceCount",
    "scanEvidenceCount",
    "resultAccepted",
    "rawMissionSha256",
    "rawMissionPath"
  ],
  "properties": {
    "schemaVersion": {
      "const": "skillstore.l3-mission-result/1"
    },
    "releaseId": {
      "const": "skillstore-office-v2-e2e-20260901-r1"
    },
    "repositoryCommit": {
      "type": "string",
      "pattern": "^[0-9a-f]{40}$"
    },
    "recordedAt": {
      "type": "string",
      "format": "date-time"
    },
    "missionId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256
    },
    "operatorAuthorized": {
      "const": true
    },
    "missionStatus": {
      "type": "string"
    },
    "navigationSucceeded": {
      "type": "boolean"
    },
    "inspectionSucceeded": {
      "type": "boolean"
    },
    "officeSequenceValidated": {
      "type": "boolean"
    },
    "allRequiredNodesSucceeded": {
      "type": "boolean"
    },
    "allRequiredHeadingsObserved": {
      "type": "boolean"
    },
    "reportFullChainAccepted": {
      "type": "boolean"
    },
    "regionIds": {
      "type": "array",
      "items": {"type": "string"},
      "maxItems": 2
    },
    "stationIds": {
      "type": "array",
      "items": {"type": "string"},
      "maxItems": 2
    },
    "headingGapCount": {
      "type": "integer",
      "minimum": 0
    },
    "reportEvidenceCount": {
      "type": "integer",
      "minimum": 0
    },
    "scanEvidenceCount": {
      "type": "integer",
      "minimum": 0
    },
    "resultAccepted": {
      "type": "boolean"
    },
    "eventCount": {
      "type": "integer",
      "minimum": 0
    },
    "worldRecordCount": {
      "type": "integer",
      "minimum": 0
    },
    "skillExecutionCount": {
      "type": "integer",
      "minimum": 0
    },
    "rawMissionSha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "rawMissionPath": {
      "type": "string",
      "minLength": 1
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {"resultAccepted": {"const": true}},
        "required": ["resultAccepted"]
      },
      "then": {
        "properties": {
          "missionStatus": {"const": "completed"},
          "navigationSucceeded": {"const": true},
          "inspectionSucceeded": {"const": true},
          "officeSequenceValidated": {"const": true},
          "allRequiredNodesSucceeded": {"const": true},
          "allRequiredHeadingsObserved": {"const": true},
          "reportFullChainAccepted": {"const": true},
          "regionIds": {
            "prefixItems": [
              {"const": "open_office"},
              {"const": "meeting_room"}
            ],
            "minItems": 2,
            "maxItems": 2
          },
          "stationIds": {
            "prefixItems": [
              {"const": "open_office_west"},
              {"const": "meeting_south"}
            ],
            "minItems": 2,
            "maxItems": 2
          },
          "headingGapCount": {"const": 0},
          "reportEvidenceCount": {"type": "integer", "minimum": 1},
          "scanEvidenceCount": {"type": "integer", "minimum": 8}
        }
      }
    }
  ]
}
